# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local overrides if needed.
# Note: DO NOT put sensitive secrets or credentials into this file or repository.
#
# Cloudflare Pages Functions and D1 connect via serverless runtime bindings:
# - Production/Preview: Configured via Cloudflare Pages dashboard (D1 database binding `DB`)
# - Local Dev: Wrangler emulates SQLite automatically in `.wrangler/`
# ==============================================================================

# (Optional) Custom API endpoint base URL if hosting frontend separately from Pages Functions:
# VITE_API_BASE_URL=

# (Optional) Application Environment Mode
# VITE_APP_ENV=development
