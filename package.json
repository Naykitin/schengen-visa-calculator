{
  "name": "schengen-visa-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist --project-name=schengen-visa-calculator",
    "d1:migrate:local": "wrangler d1 execute schengen-db --local --file=./migrations/0001_initial_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute schengen-db --remote --file=./migrations/0001_initial_schema.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
